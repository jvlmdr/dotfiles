[user]
	name = Jack Valmadre
	email = jack.valmadre@gmail.com

[init]
	defaultBranch = main

[push]
	default = current

[pull]
	rebase = false
	ff = only

[core]
	editor = vim

[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
	ui = auto

[diff]
	tool = vimdiff

[difftool]
	prompt = false

[merge]
	tool = vimdiff

[mergetool]
	keepBackup = false

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
